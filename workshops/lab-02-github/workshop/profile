# Sourced by every terminal shell. Shows the branch in the prompt, as in
# Lab 1:
#   ~/exercises/netops-lab (change/add-snmp)$
# '*' after the branch: unstaged changes; '+': staged changes.
#
# And keeps the GitHub CLI quiet: no usage data sent to GitHub, no notices
# about newer versions (the version is pinned in resources/workshop.yaml).

export GH_TELEMETRY=0
export GH_NO_UPDATE_NOTIFIER=1

if [ -f /usr/share/git-core/contrib/completion/git-prompt.sh ]; then
    . /usr/share/git-core/contrib/completion/git-prompt.sh
    GIT_PS1_SHOWDIRTYSTATE=1
    PS1='\[\e[1;34m\]\w\[\e[0m\]$(__git_ps1 " (%s)")\$ '
fi
