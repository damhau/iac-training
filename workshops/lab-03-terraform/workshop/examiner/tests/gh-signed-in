#!/bin/bash
# Last page: gh is signed in to github.com, and Git uses it for HTTPS.

. "$(dirname "$0")/../lib.sh"

github_login

git config --global --get-all credential.https://github.com.helper 2>/dev/null |
    grep -q 'auth git-credential' ||
    fail "signed in as $LOGIN, but git push won't use it: gh auth setup-git"

pass "signed in to GitHub as $LOGIN"
